# این فایل را کپی کنید به .env و واقعی پر کنید. هیچ‌وقت .env را commit نکنید.

# ---- هسته ----
DB_PATH=data/modasr.db

# ---- OpenRouter (ارائه‌دهنده‌ی اصلی هوش مصنوعی پروژه؛ از https://openrouter.ai/keys) ----
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_TIMEOUT_S=30
OPENROUTER_MAX_RETRIES=2
OPENROUTER_HISTORY_TURNS=8
# اختیاری: برای نمایش پروژه در آمار OpenRouter؛ نبودشان مشکلی ایجاد نمی‌کند
OPENROUTER_HTTP_REFERER=

# ---- Gemini (اختیاری/غیرفعال — دیگر پیش‌فرض نیست؛ هیچ ربات فعلی آن را فرانمی‌خواند) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_S=30
GEMINI_MAX_RETRIES=2
GEMINI_HISTORY_TURNS=8

# ---- تلگرام (از @BotFather) ----
BOT_TOKEN=
ADMIN_ID=

# ---- بله (از @BotFather در بله، طبق dev.bale.ai) ----
BALE_BOT_TOKEN=
