# این فایل را کپی کنید به .env و واقعی پر کنید. هیچ‌وقت .env را commit نکنید.

# ---- هسته ----
DB_PATH=data/modasr.db

# ---- Gemini (از AI Studio) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_S=30
GEMINI_MAX_RETRIES=2
GEMINI_HISTORY_TURNS=8

# ---- تلگرام (از @BotFather) ----
BOT_TOKEN=
ADMIN_ID=

# ---- بله (از @BotFather در بله، طبق dev.bale.ai) ----
BALE_BOT_TOKEN=
